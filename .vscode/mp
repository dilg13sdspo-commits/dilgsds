        </div>
      </div>

      <label class="checkbox-row" for="program-visible">
        <span>Show on public page</span>
        <input type="checkbox" id="program-visible" name="is_active" checked />
      </label>

      <p class="drawer-status" id="program-status" aria-live="polite"></p>

      <div class="drawer-actions">
        <button type="button" class="secondary-btn" id="program-cancel-btn">Cancel</button>
        <button type="submit" class="submit-btn" id="program-submit-btn">Save Program</button>
      </div>
    </form>
  </aside>

  <script>
    const state = {
      programs: [],
      filtered: [],
      page: 1,
      perPage: 5,
      search: '',
      category: 'all',
      status: 'all',
      sort: 'order_asc'
    };

    const tableBody = document.getElementById('program-table-body');
    const tableSummary = document.getElementById('table-summary');
    const pagination = document.getElementById('pagination');
    const searchInput = document.getElementById('program-search');
    const categoryFilter = document.getElementById('category-filter');
    const statusFilter = document.getElementById('status-filter');
    const sortFilter = document.getElementById('sort-filter');
    const drawer = document.getElementById('program-drawer');
    const overlay = document.getElementById('program-drawer-overlay');
    const drawerTitle = document.getElementById('program-drawer-title');
    const form = document.getElementById('program-form');
    const submitButton = document.getElementById('program-submit-btn');
    const statusBox = document.getElementById('program-status');

    function formatUpdated(dateValue) {
      if (!dateValue) return '—';
      const parsed = new Date(dateValue);
      if (Number.isNaN(parsed.getTime())) return '—';
      return parsed.toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit'
      });
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getBadgeMarkup(isActive) {
      return isActive
        ? '<span class="badge badge--published">Published</span>'
        : '<span class="badge badge--draft">Draft</span>';
    }

    function openDrawer(mode, item = null) {
      const isEdit = mode === 'edit';
      drawerTitle.textContent = isEdit ? 'Edit Program' : 'Add New Program';
      submitButton.textContent = isEdit ? 'Save Changes' : 'Save Program';
      form.reset();
      document.getElementById('program-id').value = item ? item.id : '';
      document.getElementById('program-category').value = item ? item.category || '' : '';
      document.getElementById('program-title').value = item ? item.title || '' : '';
      document.getElementById('program-link').value = item ? item.link_url || '' : '';
      document.getElementById('program-order').value = item ? (item.sort_order || 1) : 1;
      document.getElementById('program-visible').checked = !!(item ? item.is_active : true);
      setStatus('');
      drawer.classList.add('is-open');
      overlay.classList.add('is-visible');
      drawer.setAttribute('aria-hidden', 'false');
      setTimeout(function () {
        const firstInput = isEdit ? document.getElementById('program-title') : document.getElementById('program-category');
        if (firstInput) firstInput.focus();
      }, 50);
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-visible');
      drawer.setAttribute('aria-hidden', 'true');
      form.reset();
      document.getElementById('program-id').value = '';
      setStatus('');
    }

    function setStatus(message, type = '') {
      statusBox.textContent = message || '';
      statusBox.classList.remove('is-error', 'is-success');
      if (type) statusBox.classList.add(type);
    }

    function renderPagination(totalPages, currentPage) {
      pagination.innerHTML = '';
      const prev = document.createElement('button');
      prev.type = 'button';
      prev.className = 'page-btn' + (currentPage === 1 ? ' is-disabled' : '');
      prev.textContent = '‹';
      prev.disabled = currentPage === 1;
      prev.addEventListener('click', function () {
        if (currentPage > 1) {
          state.page = currentPage - 1;
          renderRows();
        }
      });
      pagination.appendChild(prev);

      for (let i = 1; i <= totalPages; i += 1) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'page-btn' + (i === currentPage ? ' is-active' : '');
        btn.textContent = String(i);
        btn.addEventListener('click', function () {
          state.page = i;
          renderRows();
        });
        pagination.appendChild(btn);
      }

      const next = document.createElement('button');
      next.type = 'button';
      next.className = 'page-btn' + (currentPage === totalPages ? ' is-disabled' : '');
      next.textContent = '›';
      next.disabled = currentPage === totalPages;
      next.addEventListener('click', function () {
        if (currentPage < totalPages) {
          state.page = currentPage + 1;
          renderRows();
        }
      });
      pagination.appendChild(next);
    }

    function renderRows() {
      const filtered = [...state.filtered];
      const totalEntries = filtered.length;
      const totalPages = Math.max(1, Math.ceil(totalEntries / state.perPage));
      if (state.page > totalPages) state.page = totalPages;

      const startIndex = totalEntries === 0 ? 0 : (state.page - 1) * state.perPage;
      const endIndex = Math.min(startIndex + state.perPage, totalEntries);
      const slice = filtered.slice(startIndex, endIndex);

      tableSummary.textContent = totalEntries === 0
        ? 'Showing 0 to 0 of 0 entries'
        : 'Showing ' + (startIndex + 1) + ' to ' + endIndex + ' of ' + totalEntries + ' entries';

      if (slice.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="6"><div style="padding: 22px 10px; color: var(--slate-500); text-align: center; font-weight: 700;">No programs found.</div></td></tr>';
        renderPagination(totalPages, state.page);
        return;
      }

      tableBody.innerHTML = slice.map(function (item) {
        const safeTitle = escapeHtml(item.title || 'Untitled Program');
        const safeCategory = escapeHtml(item.category || 'General');
        const safeLink = escapeHtml(item.link_url || '');
        const statusMarkup = getBadgeMarkup(!!item.is_active);
        const updateText = formatUpdated(item.updated_at);
        const viewLink = item.link_url
          ? '<a class="program-cell__link" href="' + safeLink + '" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/></svg>View Program Document</a>'
          : '<span style="color: var(--slate-500); font-size: 0.78rem; font-weight: 700;">No document link</span>';

        return '<tr>' +
          '<td>' +
            '<div class="program-cell">' +
              '<span class="program-cell__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4h9l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M16 4v5h5"/><path d="M8 13h8M8 17h8"/></svg></span>' +
              '<div class="program-cell__content">' +
                '<span class="program-cell__title">' + safeTitle + '</span>' +
                viewLink +
              '</div>' +
            '</div>' +
          '</td>' +
          '<td>' + safeCategory + '</td>' +
          '<td>' + statusMarkup + '</td>' +
          '<td><span class="order-pill">' + (item.sort_order || 1) + '</span></td>' +
          '<td><span class="updated-text">' + updateText + '</span></td>' +
          '<td>' +
            '<div class="action-cluster">' +
              (item.link_url ? '<a class="icon-button" href="' + safeLink + '" target="_blank" rel="noopener noreferrer" aria-label="Open program document"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/></svg></a>' : '<span class="icon-button" aria-hidden="true" style="opacity:0.45; pointer-events:none;"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/></svg></span>') +
              '<button type="button" class="icon-button" data-action="edit" data-id="' + item.id + '" aria-label="Edit program"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg></button>' +
              '<button type="button" class="icon-button icon-button--danger" data-action="delete" data-id="' + item.id + '" aria-label="Delete program"><svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg></button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      }).join('');

      renderPagination(totalPages, state.page);

      document.querySelectorAll('[data-action="edit"]').forEach(function (button) {
        button.addEventListener('click', function () {
          const itemId = Number(button.getAttribute('data-id'));
          const selected = state.programs.find(function (program) { return Number(program.id) === itemId; });
          openDrawer('edit', selected);
        });
      });

      document.querySelectorAll('[data-action="delete"]').forEach(function (button) {
        button.addEventListener('click', function () {
          const itemId = Number(button.getAttribute('data-id'));
          const selected = state.programs.find(function (program) { return Number(program.id) === itemId; });
          const confirmed = window.confirm('Delete "' + (selected && selected.title ? selected.title : 'this program') + '"?');
          if (!confirmed) return;
          deleteProgram(itemId);
        });
      });
    }

    function applyFilters() {
      const searchValue = state.search.trim().toLowerCase();
      const categoryValue = state.category;
      const statusValue = state.status;

      state.filtered = state.programs.filter(function (item) {
        const matchesSearch = !searchValue ||
          (item.title || '').toLowerCase().includes(searchValue) ||
          (item.category || '').toLowerCase().includes(searchValue);
        const matchesCategory = categoryValue === 'all' || (item.category || '') === categoryValue;
        const matchesStatus = statusValue === 'all' ||
          (statusValue === 'published' && !!item.is_active) ||
          (statusValue === 'draft' && !item.is_active);

        return matchesSearch && matchesCategory && matchesStatus;
      });

      state.filtered.sort(function (a, b) {
        if (state.sort === 'order_desc') return Number(b.sort_order || 0) - Number(a.sort_order || 0);
        if (state.sort === 'title_asc') return String(a.title || '').localeCompare(String(b.title || ''));
        if (state.sort === 'latest') return new Date(b.updated_at || 0) - new Date(a.updated_at || 0);
        return Number(a.sort_order || 0) - Number(b.sort_order || 0);
      });

      state.page = 1;
      renderRows();
    }

    function populateCategoryOptions() {
      const categories = Array.from(new Set(state.programs.map(function (item) { return item.category || 'General'; }))).sort(function (a, b) { return a.localeCompare(b); });
      const currentValue = categoryFilter.value || 'all';
      categoryFilter.innerHTML = '<option value="all">Category</option>' + categories.map(function (category) {
        return '<option value="' + escapeHtml(category) + '">' + escapeHtml(category) + '</option>';
      }).join('');
      categoryFilter.value = categories.includes(currentValue) ? currentValue : 'all';
    }

    function fetchPrograms() {
      return fetch('auth/programs_api.php', {
        headers: { 'Accept': 'application/json' }
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Unable to load programs.');
          }
          return response.json();
        })
        .then(function (payload) {
          state.programs = Array.isArray(payload.programs) ? payload.programs : [];
          populateCategoryOptions();
          applyFilters();
        })
        .catch(function (error) {
          tableBody.innerHTML = '<tr><td colspan="6"><div style="padding: 26px 10px; color: var(--danger-700); font-weight: 700; text-align: center;">' + escapeHtml(error.message) + '</div></td></tr>';
          tableSummary.textContent = 'Showing 0 to 0 of 0 entries';
        });
    }

    function submitProgram(event) {
      event.preventDefault();
      const payload = {
        id: document.getElementById('program-id').value || undefined,
        category: document.getElementById('program-category').value.trim(),
        title: document.getElementById('program-title').value.trim(),
        link_url: document.getElementById('program-link').value.trim(),
        sort_order: Number(document.getElementById('program-order').value || 1),
        is_active: document.getElementById('program-visible').checked,
        action: document.getElementById('program-id').value ? 'update' : 'create'
      };

      if (!payload.category || !payload.title || !payload.link_url) {
        setStatus('Category, title, and a valid document link are required.', 'is-error');
        return;
      }

      const requestOptions = {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      };

      fetch('auth/programs_api.php', requestOptions)
        .then(function (response) {
          return response.json().then(function (data) {
            if (!response.ok || data.error) {
              throw new Error(data.error || 'Unable to save the program.');
            }
            return data;
          });
        })
        .then(function () {
          setStatus('Program saved successfully.', 'is-success');
          closeDrawer();
          fetchPrograms();
        })
        .catch(function (error) {
          setStatus(error.message || 'Unable to save the program.', 'is-error');
        });
    }

    function deleteProgram(id) {
      fetch('auth/programs_api.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ action: 'delete', id: id })
      })
        .then(function (response) {
          return response.json().then(function (data) {
            if (!response.ok || data.error) {
              throw new Error(data.error || 'Unable to delete the program.');
            }
            return data;
          });
        })
        .then(function () {
          fetchPrograms();
        })
        .catch(function (error) {
          window.alert(error.message || 'Unable to delete the program.');
        });
    }

    document.getElementById('add-program-btn').addEventListener('click', function () {
      openDrawer('create');
    });

    document.getElementById('program-drawer-close').addEventListener('click', closeDrawer);
    document.getElementById('program-cancel-btn').addEventListener('click', closeDrawer);
    document.getElementById('program-drawer-overlay').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    form.addEventListener('submit', submitProgram);

    searchInput.addEventListener('input', function (event) {
      state.search = event.target.value;
      applyFilters();
    });

    categoryFilter.addEventListener('change', function (event) {
      state.category = event.target.value;
      applyFilters();
    });

    statusFilter.addEventListener('change', function (event) {
      state.status = event.target.value;
      applyFilters();
    });

    sortFilter.addEventListener('change', function (event) {
      state.sort = event.target.value;
      applyFilters();
    });

    fetchPrograms();
  </script>
</body>
</html>
