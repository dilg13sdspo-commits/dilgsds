<script>(function(){var api='auth/news_api.php',form=document.getElementById('news-form'),root=document.getElementById('news-records'),status=document.getElementById('form-status');function esc(v){return String(v||'').replace(/[&<>"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[c]})}function load(){fetch(api).then(function(r){return r.json()}).then(function(d){render(d.news||[])}).catch(function(){root.innerHTML='<div class="status">Unable to load news records.</div>'})}function render(rows){if(!rows.length){root.innerHTML='<div class="status">No news records.</div>';return}root.innerHTML=rows.map(function(n){return '<div class="news-row"><img src="'+esc(n.media_url)+'" alt=""><div><strong>'+esc(n.title)+'</strong><small>'+esc(n.published_date||n.type)+'</small></div><div><button type="button" data-edit="'+n.id+'">Edit</button><button type="button" class="delete" data-delete="'+n.id+'">Delete</button></div></div>'}).join('')}function clearForm(){form.reset();document.getElementById('news-id').value='';document.getElementById('form-title').textContent='Add News';document.getElementById('news-active').checked=true;status.textContent=''}root.addEventListener('click',function(e){var id=e.target.getAttribute('data-edit')||e.target.getAttribute('data-delete');if(!id)return;if(e.target.hasAttribute('data-delete')){if(!confirm('Delete this news item?'))return;fetch(api,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({action:'delete',id:id})}).then(function(){load()});return}fetch(api).then(function(r){return r.json()}).then(function(d){var n=(d.news||[]).find(function(x){return String(x.id)===String(id)});if(!n)return;['type','title','published_date','description','media_url','link_url','sort_order'].forEach(function(k){document.getElementById(k==='type'?'news-type':'news-'+k.replace('_','-')).value=n[k]||''});document.getElementById('news-id').value=n.id;document.getElementById('news-active').checked=!!n.is_active;document.getElementById('form-title').textContent='Edit News';window.scrollTo({top:0,behavior:'smooth'})})});form.addEventListener('submit',function(e){e.preventDefault();var data=new FormData(form);data.append('action',document.getElementById('news-id').value?'update':'create');fetch(api,{method:'POST',body:data}).then(function(r){return r.json()}).then(function(d){if(d.error)throw new Error(d.error);status.textContent='Saved.';clearForm();load()}).catch(function(err){status.textContent=err.message})});document.getElementById('clear-news').addEventListener('click',clearForm);document.getElementById('logout-btn').addEventListener('click',function(e){e.preventDefault();fetch('auth/logout.php',{method:'POST'}).finally(function(){location.href='index.html'})});load()}())</script>
