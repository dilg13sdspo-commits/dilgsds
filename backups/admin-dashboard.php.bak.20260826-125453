  <script>
  const sidebarToggle = document.getElementById('sidebar-toggle');
  if (sidebarToggle) {
    const savedSidebarState = localStorage.getItem('dilgSidebarCollapsed') === 'true';
    if (savedSidebarState) {
      document.body.classList.add('sidebar-collapsed');
    }
    sidebarToggle.addEventListener('click', function () {
      const collapsed = document.body.classList.toggle('sidebar-collapsed');
      localStorage.setItem('dilgSidebarCollapsed', String(collapsed));
    });
  }

  const settingsModal = document.getElementById('settings-modal');
  const settingsForm = document.getElementById('system-settings-form');
  const settingsStatus = document.getElementById('settings-status');

  function openSettingsModal() {
    settingsModal.classList.add('is-open');
    settingsModal.setAttribute('aria-hidden', 'false');
    if (settingsStatus) {
      settingsStatus.textContent = '';
    }
  }

  function closeSettingsModal() {
    settingsModal.classList.remove('is-open');
    settingsModal.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll('[data-open-settings]').forEach(function (button) {
    button.addEventListener('click', openSettingsModal);
  });

  document.querySelectorAll('[data-close-settings]').forEach(function (button) {
    button.addEventListener('click', closeSettingsModal);
  });

  settingsModal.addEventListener('click', function (event) {
    if (event.target === settingsModal || event.target.classList.contains('settings-modal__backdrop')) {
      closeSettingsModal();
    }
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && settingsModal.classList.contains('is-open')) {
      closeSettingsModal();
    }
  });

  const savedSettings = JSON.parse(localStorage.getItem('dilgSystemSettings') || '{}');
  if (savedSettings.websiteTitle) {
    settingsForm.websiteTitle.value = savedSettings.websiteTitle;
  }
  if (savedSettings.contactEmail) {
    settingsForm.contactEmail.value = savedSettings.contactEmail;
  }
  if (savedSettings.timezone) {
    settingsForm.timezone.value = savedSettings.timezone;
  }
  if (savedSettings.maintenanceMode) {
    settingsForm.maintenanceMode.value = savedSettings.maintenanceMode;
  }
  if (savedSettings.publishState) {
    settingsForm.publishState.value = savedSettings.publishState;
  }

  settingsForm.addEventListener('submit', function (event) {
    event.preventDefault();
    const formData = new FormData(settingsForm);
    const values = Object.fromEntries(formData.entries());
    localStorage.setItem('dilgSystemSettings', JSON.stringify(values));
    if (settingsStatus) {
      settingsStatus.textContent = 'Settings saved successfully.';
    }
    closeSettingsModal();
  });

  document.getElementById('logout-btn').addEventListener('click', async function (e) {
    e.preventDefault();
    try {
      await fetch('auth/logout.php', { method: 'POST' });
    } finally {
      location.href = 'index.html';
    }
  });

  </script>
