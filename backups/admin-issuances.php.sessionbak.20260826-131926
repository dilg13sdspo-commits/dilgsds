  <script>
    (function () {
      var api = 'auth/issuances_api.php';
      var form = document.getElementById('issuance-form');
      var records = document.getElementById('issuance-records');
      var status = document.getElementById('form-status');

      function esc(value) {
        return String(value || '').replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
        });
      }

      function load() {
        fetch(api)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            render(data.issuances || []);
          })
          .catch(function () {
            records.innerHTML = '<div class="status">Unable to load issuances.</div>';
          });
      }

      function render(rows) {
        if (!rows.length) {
          records.innerHTML = '<div class="status">No issuances.</div>';
          return;
        }

        records.innerHTML = rows.map(function (item) {
          return '<div class="issuance-row"><div><strong>' + esc(item.title) + '</strong><small>' + esc(item.reference_number || item.issued_date || 'Issuance') + '</small></div><div><button type="button" data-edit="' + item.id + '">Edit</button><button type="button" class="delete" data-delete="' + item.id + '">Delete</button></div></div>';
        }).join('');
      }

      function clearForm() {
        form.reset();
        document.getElementById('issuance-id').value = '';
        document.getElementById('form-title').textContent = 'Add Issuance';
        document.getElementById('issuance-active').checked = true;
        status.textContent = '';
      }

      records.addEventListener('click', function (event) {
        var id = event.target.getAttribute('data-edit') || event.target.getAttribute('data-delete');
        if (!id) return;

        if (event.target.hasAttribute('data-delete')) {
          if (!confirm('Delete this issuance?')) return;
          fetch(api, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ action: 'delete', id: id })
          }).then(function () {
            load();
          });
          return;
        }

        fetch(api)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var item = (data.issuances || []).find(function (entry) {
              return String(entry.id) === String(id);
            });
            if (!item) return;

            document.getElementById('issuance-id').value = item.id;
            document.getElementById('issuance-title').value = item.title || '';
            document.getElementById('issuance-number').value = item.reference_number || '';
            document.getElementById('issuance-date').value = item.issued_date || '';
            document.getElementById('issuance-link').value = item.link_url || '';
            document.getElementById('issuance-summary').value = item.summary || '';
            document.getElementById('issuance-order').value = item.sort_order || 1;
            document.getElementById('issuance-active').checked = !!item.is_active;
            document.getElementById('form-title').textContent = 'Edit Issuance';
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
      });

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var data = new FormData(form);
        data.append('action', document.getElementById('issuance-id').value ? 'update' : 'create');

        fetch(api, {
          method: 'POST',
          body: data
        })
          .then(function (r) { return r.json(); })
          .then(function (result) {
            if (result.error) throw new Error(result.error);
            status.textContent = 'Saved.';
            clearForm();
            load();
          })
          .catch(function (error) {
            status.textContent = error.message || 'Unable to save issuance.';
          });
      });

      document.getElementById('clear-issuance').addEventListener('click', clearForm);
      load();
    }());

    (function () {
      var toggle = document.getElementById('sidebar-toggle');
      if (!toggle) return;
      var body = document.body;
      function apply(collapsed) {
        body.classList.toggle('sidebar-collapsed', collapsed);
        toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        toggle.innerHTML = collapsed ? '<span>›</span>' : '<span>‹</span>';
      }
      try {
        apply(localStorage.getItem('dilg-admin-sidebar-collapsed') === '1');
      } catch (error) {
        apply(false);
      }
      toggle.addEventListener('click', function () {
        var collapsed = body.classList.toggle('sidebar-collapsed');
        try {
          localStorage.setItem('dilg-admin-sidebar-collapsed', collapsed ? '1' : '0');
        } catch (error) {}
        toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        toggle.innerHTML = collapsed ? '<span>›</span>' : '<span>‹</span>';
      });
