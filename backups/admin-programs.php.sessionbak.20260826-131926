  <script>
    (function () {
      var api = 'auth/programs_api.php';
      var form = document.getElementById('program-form');
      var root = document.getElementById('programs-list');
      var status = document.getElementById('program-status');

      function esc(value) {
        return String(value || '').replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
        });
      }

      function clearForm() {
        form.reset();
        document.getElementById('id').value = '';
        document.getElementById('sort_order').value = '1';
        document.getElementById('is_active').checked = true;
        document.getElementById('form-title').textContent = 'Add Program';
        if (status) status.textContent = '';
      }

      function load() {
        fetch(api)
          .then(function (response) { return response.json(); })
          .then(function (payload) {
            var programs = Array.isArray(payload && payload.programs) ? payload.programs : [];
            programs = programs.slice().sort(function (a, b) {
              return Number(a.sort_order || 0) - Number(b.sort_order || 0);
            });

            if (!programs.length) {
              root.innerHTML = '<div class="status">No programs found.</div>';
              return;
            }

            root.innerHTML = programs.map(function (program) {
              return '<div class="program-row">' +
                '<div><strong>' + esc(program.title || '') + '</strong><small>' + esc(program.category || '') + '<br>' + esc(program.link_url || '') + '</small></div>' +
                '<div class="program-row__actions"><button type="button" data-edit="' + program.id + '">Edit</button><button type="button" class="delete" data-delete="' + program.id + '">Delete</button></div>' +
                '</div>';
            }).join('');
          })
          .catch(function () {
            root.innerHTML = '<div class="status">Unable to load programs.</div>';
          });
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var formData = new FormData(form);
        formData.append('action', document.getElementById('id').value ? 'update' : 'create');

        fetch(api, {
          method: 'POST',
          body: formData
        })
          .then(function (response) { return response.json(); })
          .then(function (result) {
            if (result && result.error) throw new Error(result.error);
            status.textContent = 'Program saved successfully.';
            clearForm();
            load();
          })
          .catch(function (error) {
            status.textContent = error.message || 'Unable to save program.';
          });
      });

      root.addEventListener('click', function (event) {
        var button = event.target;
        var id = button.getAttribute('data-edit') || button.getAttribute('data-delete');
        if (!id) return;

        if (button.hasAttribute('data-delete')) {
          if (!confirm('Delete this program?')) return;
          fetch(api, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ action: 'delete', id: id })
          })
            .then(function () { load(); })
            .catch(function () {
              status.textContent = 'Unable to delete program.';
            });
          return;
        }

        fetch(api)
          .then(function (response) { return response.json(); })
          .then(function (payload) {
            var programs = Array.isArray(payload && payload.programs) ? payload.programs : [];
            var program = programs.find(function (item) { return String(item.id) === id; });
            if (!program) return;
            document.getElementById('id').value = program.id;
            document.getElementById('category').value = program.category || '';
            document.getElementById('title').value = program.title || '';
            document.getElementById('link_url').value = program.link_url || '';
            document.getElementById('sort_order').value = program.sort_order || 1;
            document.getElementById('is_active').checked = !!program.is_active;
            document.getElementById('form-title').textContent = 'Edit Program';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            document.getElementById('category').focus();
          });
      });

      document.getElementById('clear-program').addEventListener('click', clearForm);

      document.getElementById('logout-btn').addEventListener('click', function (event) {
        event.preventDefault();
        fetch('auth/logout.php', { method: 'POST' }).finally(function () {
          location.href = 'index.html';
        });
      });

      var settingsModal = document.getElementById('settings-modal');
      function openSettingsModal() {
        settingsModal.classList.add('is-open');
        settingsModal.setAttribute('aria-hidden', 'false');
      }
      function closeSettingsModal() {
        settingsModal.classList.remove('is-open');
        settingsModal.setAttribute('aria-hidden', 'true');
      }
      document.querySelectorAll('[data-open-settings]').forEach(function (button) {
        button.addEventListener('click', openSettingsModal);
      });
      document.querySelectorAll('[data-close-settings]').forEach(function (button) {
        button.addEventListener('click', closeSettingsModal);
      });
      settingsModal.addEventListener('click', function (event) {
        if (event.target === settingsModal || event.target.classList.contains('settings-modal__backdrop')) {
          closeSettingsModal();
        }
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && settingsModal.classList.contains('is-open')) {
          closeSettingsModal();
        }
      });
      var savedSettings = JSON.parse(localStorage.getItem('dilgSystemSettings') || '{}');
      var settingsForm = document.getElementById('system-settings-form');
      if (savedSettings.websiteTitle) settingsForm.websiteTitle.value = savedSettings.websiteTitle;
      if (savedSettings.contactEmail) settingsForm.contactEmail.value = savedSettings.contactEmail;
      if (savedSettings.timezone) settingsForm.timezone.value = savedSettings.timezone;
      if (savedSettings.maintenanceMode) settingsForm.maintenanceMode.value = savedSettings.maintenanceMode;
      if (savedSettings.publishState) settingsForm.publishState.value = savedSettings.publishState;
      settingsForm.addEventListener('submit', function (event) {
        event.preventDefault();
        var values = Object.fromEntries(new FormData(settingsForm).entries());
        localStorage.setItem('dilgSystemSettings', JSON.stringify(values));
        document.getElementById('settings-status').textContent = 'Settings saved successfully.';
        closeSettingsModal();
      });

      var toggle = document.getElementById('sidebar-toggle');
      if (toggle) {
        var body = document.body;
        function apply(collapsed) {
          body.classList.toggle('sidebar-collapsed', collapsed);
          toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
          toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
          toggle.innerHTML = collapsed ? '<span>›</span>' : '<span>‹</span>';
        }
        try {
          apply(localStorage.getItem('dilg-admin-sidebar-collapsed') === '1');
        } catch (error) {
          apply(false);
        }
        toggle.addEventListener('click', function () {
          var collapsed = body.classList.toggle('sidebar-collapsed');
          try {
            localStorage.setItem('dilg-admin-sidebar-collapsed', collapsed ? '1' : '0');
          } catch (error) {}
          toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
          toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
          toggle.innerHTML = collapsed ? '<span>›</span>' : '<span>‹</span>';
        });
      }

      load();
    }());
  </script>
</body>
</html>
