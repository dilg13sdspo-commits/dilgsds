ass="programs-admin"><h1>Programs &amp; Services Management</h1><p>Manage program categories, links, display order, and public visibility.</p><div class="programs-grid"><form class="program-form" id="program-form"><h2 id="form-title">Add Program</h2><input type="hidden" id="program-id" name="id"><label for="category">Category / Outcome Area</label><input id="category" name="category" required><label for="title">Program or Service</label><input id="title" name="title" required><label for="link-url">Program Link</label><input id="link-url" name="link_url" type="url" placeholder="https://..."><label for="sort-order">Display order</label><input id="sort-order" name="sort_order" type="number" min="1" value="1"><label><input id="active" name="is_active" type="checkbox" checked> Show on public page</label><div class="form-actions"><button id="save-program" type="submit">Save Program</button><button id="clear-program" type="button">Clear</button></div><div class="status" id="status" role="status"></div></form><section class="program-list"><h2>Program Records</h2><div id="records"><div class="status">Loading...</div></div></section></div></section></main></div><script>(function(){var api='auth/programs_api.php',form=document.getElementById('program-form'),root=document.getElementById('records'),status=document.getElementById('status');function esc(v){return String(v||'').replace(/[&<>"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[c]})}function load(){fetch(api).then(function(r){return r.json()}).then(function(d){render(d.programs||[])}).catch(function(){root.innerHTML='<div class="status">Unable to load programs.</div>'})}function render(rows){if(!rows.length){root.innerHTML='<div class="status">No programs.</div>';return}root.innerHTML=rows.map(function(r){return '<div class="program-row"><div><strong>'+esc(r.title)+'</strong><small>'+esc(r.category)+'</small></div><div><button type="button" data-edit="'+r.id+'">Edit</button><button type="button" class="delete" data-delete="'+r.id+'">Delete</button></div></div>'}).join('')}function clear(){form.reset();document.getElementById('program-id').value='';document.getElementById('form-title').textContent='Add Program';document.getElementById('active').checked=true;status.textContent=''}root.addEventListener('click',function(e){var id=e.target.getAttribute('data-edit')||e.target.getAttribute('data-delete');if(!id)return;if(e.target.hasAttribute('data-delete')){if(!confirm('Delete this program?'))return;fetch(api,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({action:'delete',id:id})}).then(function(){load()});return}fetch(api).then(function(r){return r.json()}).then(function(d){var r=(d.programs||[]).find(function(x){return String(x.id)===String(id)});if(!r)return;['category','title','link_url','sort_order'].forEach(function(k){document.getElementById(k.replace('_','-')).value=r[k]||''});document.getElementById('program-id').value=r.id;document.getElementById('active').checked=!!r.is_active;document.getElementById('form-title').textContent='Edit Program';window.scrollTo({top:0,behavior:'smooth'})})});form.addEventListener('submit',function(e){e.preventDefault();var d=new FormData(form);d.append('action',document.getElementById('program-id').value?'update':'create');fetch(api,{method:'POST',body:d}).then(function(r){return r.json()}).then(function(x){if(x.error)throw new Error(x.error);status.textContent='Saved.';clear();load()}).catch(function(x){status.textContent=x.message})});document.getElementById('clear-program').addEventListener('click',clear);document.getElementById('logout').addEventListener('click',function(e){e.preventDefault();fetch('auth/logout.php',{method:'POST'}).finally(function(){location.href='index.html'})});load()}())</script>
<div class="settings-modal" id="settings-modal" aria-hidden="true">
  <div class="settings-modal__backdrop" data-close-settings></div>
  <div class="settings-modal__panel" role="dialog" aria-modal="true" aria-labelledby="settings-title">
    <div class="settings-modal__header"><h2 id="settings-title">System Settings</h2><button type="button" class="settings-modal__close" aria-label="Close settings" data-close-settings>×</button></div>
    <form class="settings-form" id="system-settings-form">
      <label>Website Title<input type="text" name="websiteTitle" value="DILG SDS" /></label>
      <div class="settings-form__row"><label>Contact Email<input type="email" name="contactEmail" value="info@dilg.gov.ph" /></label><label>Default Timezone<select name="timezone"><option value="Asia/Manila" selected>Asia/Manila</option><option value="UTC">UTC</option><option value="America/New_York">America/New_York</option></select></label></div>
      <div class="settings-form__row"><label>Maintenance Mode<select name="maintenanceMode"><option value="off" selected>Off</option><option value="on">On</option></select></label><label>Default Publishing<select name="publishState"><option value="published" selected>Published</option><option value="draft">Draft</option></select></label></div>
      <div class="settings-modal__actions"><button type="button" class="settings-btn settings-btn--secondary" data-close-settings>Cancel</button><button type="submit" class="settings-btn settings-btn--primary">Save Settings</button></div>
    </form>
    <p class="settings-status" id="settings-status" aria-live="polite"></p>
  </div>
</div>
<script>
const settingsModal = document.getElementById('settings-modal');
const settingsForm = document.getElementById('system-settings-form');
const settingsStatus = document.getElementById('settings-status');
function openSettingsModal() { if (!settingsModal) return; settingsModal.classList.add('is-open'); settingsModal.setAttribute('aria-hidden', 'false'); if (settingsStatus) settingsStatus.textContent = ''; }
function closeSettingsModal() { if (!settingsModal) return; settingsModal.classList.remove('is-open'); settingsModal.setAttribute('aria-hidden', 'true'); }
document.querySelectorAll('[data-open-settings]').forEach(function(button){ button.addEventListener('click', openSettingsModal); });
document.querySelectorAll('[data-close-settings]').forEach(function(button){ button.addEventListener('click', closeSettingsModal); });
if (settingsModal) { settingsModal.addEventListener('click', function(event) { if (event.target === settingsModal || event.target.classList.contains('settings-modal__backdrop')) { closeSettingsModal(); } }); }
document.addEventListener('keydown', function(event) { if (event.key === 'Escape' && settingsModal && settingsModal.classList.contains('is-open')) { closeSettingsModal(); } });
if (settingsForm) {
  const savedSettings = JSON.parse(localStorage.getItem('dilgSystemSettings') || '{}');
  if (savedSettings.websiteTitle) settingsForm.websiteTitle.value = savedSettings.websiteTitle;
  if (savedSettings.contactEmail) settingsForm.contactEmail.value = savedSettings.contactEmail;
  if (savedSettings.timezone) settingsForm.timezone.value = savedSettings.timezone;
  if (savedSettings.maintenanceMode) settingsForm.maintenanceMode.value = savedSettings.maintenanceMode;
  if (savedSettings.publishState) settingsForm.publishState.value = savedSettings.publishState;
  settingsForm.addEventListener('submit', function(event) { event.preventDefault(); const formData = new FormData(settingsForm); const values = Object.fromEntries(formData.entries()); localStorage.setItem('dilgSystemSettings', JSON.stringify(values)); if (settingsStatus) settingsStatus.textContent = 'Settings saved successfully.'; closeSettingsModal(); });
}
</script>
</body></html>
